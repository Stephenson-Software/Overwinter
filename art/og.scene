# Overwinter - the picture under the link-preview card (web/og.png). Not a
# location still: it is not in stills.json and never ships in game.zip. It is
# the strip seen at noon on day 20 (2021-01-29 at 78 N, 14 E; see the
# "setting" in stills.json), the first day the sky shows twilight, with the
# station's lamps lit. art/render_og.py renders it with strata-golden and sets
# the title over it; see that file.
size 2400 1260
camera 2 3.2 34  10 2.4 -6  58 0.3 420
lighting sun 0.5 78 4 2048 120 0.6 1
clear 0 0 0 1 sky
sun date 2021-01-29 12:00 1 78.0 14.0
# snowfield, and the strip itself: gravel showing through, running north
item cube 40 -0.5 0  260 1 500  0.82 0.85 0.90
item cube 6 0.01 0  18 0.04 300  0.50 0.50 0.52
item cube -2.6 0.03 0  0.6 0.04 300  0.82 0.85 0.90
item cube 14.6 0.03 0  0.6 0.04 300  0.82 0.85 0.90
# the bay to the west: frozen, flat, darker than the snow
item cube -150 -0.7 0  300 1 600  0.40 0.43 0.48
# marker drums along the strip's edges
item cylinder -3 0.45 30  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder -3 0.45 0  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder -3 0.45 -30  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder -3 0.45 -60  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder 15 0.45 30  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder 15 0.45 0  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder 15 0.45 -30  0.6 0.45 0.6  0.75 0.25 0.10
item cylinder 15 0.45 -60  0.6 0.45 0.6  0.75 0.25 0.10
# the windsock, straight out to the west on its mast
item cylinder 18 3 12  0.16 3 0.16  0.30 0.30 0.30
item cube 16.9 5.7 12  2.2 0.06 0.06  0.30 0.30 0.30
item cube 16.4 5.7 12  1.0 0.8 0.8  0.95 0.45 0.10
item cube 15.4 5.7 12  1.0 0.7 0.7  0.92 0.92 0.92
item cube 14.4 5.7 12  1.0 0.6 0.6  0.95 0.45 0.10
item cube 13.4 5.7 12  1.0 0.5 0.5  0.92 0.92 0.92
# a lamp on a post at the strip's near end, burning
item cylinder 12 1.6 20  0.12 1.6 0.12  0.20 0.20 0.20
item cube 12.3 3.45 20  0.7 0.06 0.06  0.20 0.20 0.20
item sphere 12.6 3.3 20  0.3 0.3 0.3  1.0 0.85 0.55
light point 12.6 3.1 20  30  1.0 0.80 0.50  4.0
# the yard lamps on the huts' strip side
light point 20 4.2 -4  34  1.0 0.80 0.52  5.0 shadow
item sphere 21.6 4.0 -4  0.3 0.3 0.3  1.0 0.85 0.55
light point 8 3.0 -40  20  1.0 0.80 0.52  1.6
include _station_huts.scene
include _ridge.scene
