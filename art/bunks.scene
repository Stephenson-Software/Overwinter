# Overwinter - the bunkroom. "Four bunks, a stove, your notebook under the
# pillow. Teo's light is on." No figures are drawn. Provisional art
# (RFC 0025): see stills.json.
size 640 360
camera 1.2 1.6 2.4  0.0 0.85 -1.4  74 0.1 60
lighting sun 0.5 78 4 2048 20 0.6 0
clear 0 0 0 1 sky
include _hut.scene
include _bunk_left.scene
